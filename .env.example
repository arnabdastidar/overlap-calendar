# Direct browser OAuth (recommended for self-service calendar connections)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Required when direct OAuth is enabled. Generate at least 32 random bytes.
TOKEN_ENCRYPTION_KEY=

# Optional MarimerLLC/calendar-mcp HTTP server (admin-provisioned accounts)
CALENDAR_MCP_URL=
CALENDAR_MCP_API_KEY=

# Local UI testing only. Never enable this on a real shared deployment.
ENABLE_DEMO_CALENDARS=false
