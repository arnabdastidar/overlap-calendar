# Direct browser OAuth (optional; demo calendars work without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Required when direct OAuth is enabled. Generate at least 32 random bytes.
TOKEN_ENCRYPTION_KEY=

# Optional MarimerLLC/calendar-mcp HTTP server
CALENDAR_MCP_URL=http://localhost:8080
CALENDAR_MCP_API_KEY=
